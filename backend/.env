# ============================================================
# Alice Learn 后端环境变量模板（此文件会提交到 Git，不要写真实密钥）
#
# 用法：
#   1. 复制一份为 .env.local（已在 .gitignore 中，不会提交）
#   2. 在 .env.local 里填真实的数据库密码、DeepSeek Key、JWT 密钥
#   3. 启动后端即可；.env.local 的值会覆盖这里的值
#
# 优先级（低 → 高）：.env  <  .env.local  <  操作系统环境变量
# 例如 CI / 服务器上直接 export DEEPSEEK_API_KEY=xxx 也能覆盖。
# ============================================================

# ---- 服务 ----
SERVER_PORT=8080

# ---- 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alice_learn
DB_USERNAME=root
# 真实密码写到 .env.local（这里故意不设值：缺失时启动会直接报错，而不是拿空密码去连）
# DB_PASSWORD=

# ---- DeepSeek（OpenAI 兼容）----
AI_BASE_URL=https://api.deepseek.com
# 现役模型：deepseek-v4-flash（最便宜，够用）/ deepseek-v4-pro（约 3 倍价格）
# 旧别名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线，不要再用
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.7
# 单次回复输出上限（token）
AI_MAX_TOKENS=2000
# V4 默认开 thinking（推理 token 也计费，流式要等推理完才出正文）；范文/批改不需要，默认关
AI_THINKING=false
# 真实 Key 写到 .env.local；保持 sk-not-configured 时 AI 功能会提示未配置，其它模块照常可用
DEEPSEEK_API_KEY=sk-not-configured

# ---- JWT ----
# 至少 32 个字符；真实值写到 .env.local（同样故意不设值，避免空密钥被静默使用）
# JWT_SECRET=
JWT_EXPIRE_HOURS=72

# ---- CORS（多个用英文逗号分隔）----
CORS_ALLOWED_ORIGINS=http://localhost:5173
